rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow user access to all nested subcollections
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /accounts/{accountId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /sms_rules/{ruleId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
      
      match /categories/{categoryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /recurring_expenses/{recurringExpenseId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /budgets/{budgetId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /pending_dues/{dueId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /statements/{statementId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /metadata/{metaId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /support_messages/{messageId} {
      allow create: if request.auth != null;
    }
  }
}
